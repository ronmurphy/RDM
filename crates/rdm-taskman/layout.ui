<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>

  <object class="GtkBox" id="main_box">
    <property name="orientation">vertical</property>
    <property name="hexpand">true</property>
    <property name="vexpand">true</property>
    <property name="spacing">0</property>

    <child>
      <object class="GtkHeaderBar" id="header_bar">
        <property name="show-title-buttons">true</property>
        <child type="title">
          <object class="GtkLabel">
            <property name="label">Task Manager</property>
            <style>
              <class name="title"/>
            </style>
          </object>
        </child>
        <child type="start">
          <object class="GtkButton" id="refresh_btn">
            <property name="icon-name">view-refresh-symbolic</property>
            <property name="tooltip-text">Refresh</property>
          </object>
        </child>
      </object>
    </child>

    <child>
      <object class="GtkNotebook" id="main_notebook">
        <property name="hexpand">true</property>
        <property name="vexpand">true</property>
        <property name="scrollable">true</property>

        <!-- ===== Processes tab ===== -->
        <child>
          <object class="GtkBox" id="processes_page">
            <property name="orientation">vertical</property>
            <property name="spacing">8</property>
            <property name="margin-start">10</property>
            <property name="margin-end">10</property>
            <property name="margin-top">10</property>
            <property name="margin-bottom">10</property>

            <child>
              <object class="GtkSearchEntry" id="search_entry">
                <property name="placeholder-text">Search processes…</property>
                <property name="hexpand">true</property>
              </object>
            </child>

            <child>
              <object class="GtkScrolledWindow" id="process_scroll">
                <property name="hexpand">true</property>
                <property name="vexpand">true</property>
                <property name="has-frame">true</property>
                <property name="min-content-height">220</property>
              </object>
            </child>

            <child>
              <object class="GtkFrame">
                <property name="label">System Load</property>
                <child>
                  <object class="GtkGrid">
                    <property name="row-spacing">6</property>
                    <property name="column-spacing">12</property>
                    <property name="margin-start">10</property>
                    <property name="margin-end">10</property>
                    <property name="margin-top">8</property>
                    <property name="margin-bottom">8</property>

                    <!-- CPU -->
                    <child>
                      <object class="GtkLabel">
                        <property name="label">CPU</property>
                        <property name="xalign">0</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLevelBar" id="cpu_bar">
                        <property name="hexpand">true</property>
                        <property name="min-value">0</property>
                        <property name="max-value">100</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="cpu_label">
                        <property name="label">0%</property>
                        <property name="xalign">1</property>
                        <property name="width-chars">6</property>
                        <layout>
                          <property name="column">2</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>

                    <!-- Memory -->
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Memory</property>
                        <property name="xalign">0</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">1</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLevelBar" id="mem_bar">
                        <property name="hexpand">true</property>
                        <property name="min-value">0</property>
                        <property name="max-value">100</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">1</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="mem_label">
                        <property name="label">0 / 0 GB</property>
                        <property name="xalign">1</property>
                        <property name="width-chars">16</property>
                        <layout>
                          <property name="column">2</property>
                          <property name="row">1</property>
                        </layout>
                      </object>
                    </child>

                    <!-- Swap -->
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Swap</property>
                        <property name="xalign">0</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">2</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLevelBar" id="swap_bar">
                        <property name="hexpand">true</property>
                        <property name="min-value">0</property>
                        <property name="max-value">100</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">2</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="swap_label">
                        <property name="label">0 / 0 GB</property>
                        <property name="xalign">1</property>
                        <property name="width-chars">16</property>
                        <layout>
                          <property name="column">2</property>
                          <property name="row">2</property>
                        </layout>
                      </object>
                    </child>

                    <!-- Uptime -->
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Uptime</property>
                        <property name="xalign">0</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">3</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="uptime_label">
                        <property name="label">—</property>
                        <property name="xalign">0</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">3</property>
                          <property name="column-span">2</property>
                        </layout>
                      </object>
                    </child>

                    <!-- Processes / Threads count -->
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Totals</property>
                        <property name="xalign">0</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">4</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="totals_label">
                        <property name="label">0 processes · 0 threads</property>
                        <property name="xalign">0</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">4</property>
                          <property name="column-span">2</property>
                        </layout>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="GtkBox">
                <property name="orientation">horizontal</property>
                <property name="spacing">8</property>
                <property name="halign">end</property>

                <child>
                  <object class="GtkButton" id="details_btn">
                    <property name="label">Details</property>
                    <property name="sensitive">false</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="end_task_btn">
                    <property name="label">End Task</property>
                    <property name="sensitive">false</property>
                    <style>
                      <class name="destructive-action"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child type="tab">
          <object class="GtkLabel">
            <property name="label">Processes</property>
          </object>
        </child>

        <!-- ===== Performance tab ===== -->
        <child>
          <object class="GtkScrolledWindow" id="performance_page">
            <property name="hexpand">true</property>
            <property name="vexpand">true</property>
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">12</property>
                <property name="margin-start">12</property>
                <property name="margin-end">12</property>
                <property name="margin-top">12</property>
                <property name="margin-bottom">12</property>

                <!-- CPU per-core -->
                <child>
                  <object class="GtkFrame">
                    <property name="label">CPU</property>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">6</property>
                        <property name="margin-start">10</property>
                        <property name="margin-end">10</property>
                        <property name="margin-top">8</property>
                        <property name="margin-bottom">8</property>
                        <child>
                          <object class="GtkLabel" id="perf_cpu_label">
                            <property name="label">CPU: —</property>
                            <property name="xalign">0</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkGrid" id="per_core_grid">
                            <property name="row-spacing">4</property>
                            <property name="column-spacing">10</property>
                            <property name="hexpand">true</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>

                <!-- Memory -->
                <child>
                  <object class="GtkFrame">
                    <property name="label">Memory</property>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="margin-start">10</property>
                        <property name="margin-end">10</property>
                        <property name="margin-top">8</property>
                        <property name="margin-bottom">8</property>
                        <child>
                          <object class="GtkLabel" id="perf_mem_label">
                            <property name="label">Memory: —</property>
                            <property name="xalign">0</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>

                <!-- Disk I/O -->
                <child>
                  <object class="GtkFrame">
                    <property name="label">Disk I/O</property>
                    <child>
                      <object class="GtkScrolledWindow" id="disk_io_scroll">
                        <property name="min-content-height">120</property>
                        <property name="hexpand">true</property>
                        <property name="has-frame">false</property>
                      </object>
                    </child>
                  </object>
                </child>

                <!-- Disk usage -->
                <child>
                  <object class="GtkFrame">
                    <property name="label">Disk Usage</property>
                    <child>
                      <object class="GtkScrolledWindow" id="disk_usage_scroll">
                        <property name="min-content-height">140</property>
                        <property name="hexpand">true</property>
                        <property name="has-frame">false</property>
                      </object>
                    </child>
                  </object>
                </child>

                <!-- Network -->
                <child>
                  <object class="GtkFrame">
                    <property name="label">Network</property>
                    <child>
                      <object class="GtkScrolledWindow" id="network_scroll">
                        <property name="min-content-height">120</property>
                        <property name="hexpand">true</property>
                        <property name="has-frame">false</property>
                      </object>
                    </child>
                  </object>
                </child>

                <!-- System info -->
                <child>
                  <object class="GtkFrame">
                    <property name="label">System</property>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">4</property>
                        <property name="margin-start">10</property>
                        <property name="margin-end">10</property>
                        <property name="margin-top">8</property>
                        <property name="margin-bottom">8</property>
                        <child>
                          <object class="GtkLabel" id="perf_load_label">
                            <property name="label">Load average: —</property>
                            <property name="xalign">0</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="perf_kernel_label">
                            <property name="label">Kernel: —</property>
                            <property name="xalign">0</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="perf_host_label">
                            <property name="label">Host: —</property>
                            <property name="xalign">0</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child type="tab">
          <object class="GtkLabel">
            <property name="label">Performance</property>
          </object>
        </child>

        <!-- ===== Users tab ===== -->
        <child>
          <object class="GtkBox" id="users_page">
            <property name="orientation">vertical</property>
            <property name="spacing">8</property>
            <property name="margin-start">10</property>
            <property name="margin-end">10</property>
            <property name="margin-top">10</property>
            <property name="margin-bottom">10</property>

            <child>
              <object class="GtkLabel" id="users_summary_label">
                <property name="label">Aggregated from running processes. Updates with the 2-second refresh.</property>
                <property name="xalign">0</property>
                <style>
                  <class name="dim-label"/>
                </style>
              </object>
            </child>

            <child>
              <object class="GtkScrolledWindow" id="users_scroll">
                <property name="hexpand">true</property>
                <property name="vexpand">true</property>
                <property name="has-frame">true</property>
                <property name="min-content-height">220</property>
              </object>
            </child>
          </object>
        </child>
        <child type="tab">
          <object class="GtkLabel">
            <property name="label">Users</property>
          </object>
        </child>

        <!-- ===== Services tab ===== -->
        <child>
          <object class="GtkBox" id="services_page">
            <property name="orientation">vertical</property>
            <property name="spacing">8</property>
            <property name="margin-start">10</property>
            <property name="margin-end">10</property>
            <property name="margin-top">10</property>
            <property name="margin-bottom">10</property>

            <child>
              <object class="GtkSearchEntry" id="services_search">
                <property name="placeholder-text">Search services…</property>
                <property name="hexpand">true</property>
              </object>
            </child>

            <child>
              <object class="GtkScrolledWindow" id="services_scroll">
                <property name="hexpand">true</property>
                <property name="vexpand">true</property>
                <property name="has-frame">true</property>
                <property name="min-content-height">260</property>
              </object>
            </child>

            <child>
              <object class="GtkLabel" id="services_status_label">
                <property name="label">0 services</property>
                <property name="xalign">0</property>
                <style>
                  <class name="dim-label"/>
                </style>
              </object>
            </child>

            <child>
              <object class="GtkBox">
                <property name="orientation">horizontal</property>
                <property name="spacing">8</property>
                <property name="halign">end</property>

                <child>
                  <object class="GtkButton" id="svc_refresh_btn">
                    <property name="label">Refresh</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="svc_start_btn">
                    <property name="label">Start</property>
                    <property name="sensitive">false</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="svc_stop_btn">
                    <property name="label">Stop</property>
                    <property name="sensitive">false</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="svc_restart_btn">
                    <property name="label">Restart</property>
                    <property name="sensitive">false</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child type="tab">
          <object class="GtkLabel">
            <property name="label">Services</property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
