#!/bin/sh
# rdm-lock — lock screen with wallpaper background
#
# Uses the wallpaper from rdm.toml as the lock screen background.
# Display blanking is handled by the global swayidle (via rdm-session).
#
# Usage:
#   rdm-lock          Lock screen (blocks until unlock)
#   rdm-lock --idle   Lock screen and daemonize (for swayidle/before-sleep)

RDM_TOML="${XDG_CONFIG_HOME:-$HOME/.config}/rdm/rdm.toml"
FALLBACK_COLOR="#1a1b26"

# ── Read wallpaper path from rdm.toml ────────────────────────────────
WALLPAPER=""
if [ -f "$RDM_TOML" ]; then
    WALLPAPER=$(grep -A5 '^\[wallpaper\]' "$RDM_TOML" \
        | grep '^path' \
        | head -1 \
        | sed 's/^path *= *"\(.*\)"/\1/')
fi

# ── Build args ───────────────────────────────────────────────────────
ARGS="--indicator-caps-lock --show-failed-attempts"
if [ -n "$WALLPAPER" ] && [ -f "$WALLPAPER" ]; then
    ARGS="$ARGS -i $WALLPAPER -s fill"
else
    ARGS="$ARGS -c $FALLBACK_COLOR"
fi

# ── Ensure all outputs are on when swaylock needs to show ────────────
# After DPMS blanking, the lock screen needs visible outputs to accept
# the password.  Turn everything on before swaylock takes over.
if command -v wlopm >/dev/null 2>&1; then
    wlopm --on '*' 2>/dev/null
fi

# --idle: daemonize (for swayidle timeout / before-sleep).
#   swaylock -f forks into background.  We spawn a watcher that polls
#   for the swaylock process and restores DPMS when it exits (unlock).
if [ "${1:-}" = "--idle" ]; then
    # shellcheck disable=SC2086
    swaylock -f $ARGS
    # Background watcher: once swaylock disappears, turn screens on.
    (
        while pgrep -x swaylock >/dev/null 2>&1; do
            sleep 1
        done
        if command -v wlopm >/dev/null 2>&1; then
            wlopm --on '*' 2>/dev/null
        fi
    ) &
else
    # Blocking mode (Super+L): swaylock blocks until unlock.
    # shellcheck disable=SC2086
    swaylock $ARGS
    # Restore all outputs after unlock.
    if command -v wlopm >/dev/null 2>&1; then
        wlopm --on '*' 2>/dev/null
    fi
fi
