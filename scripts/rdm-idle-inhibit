#!/bin/bash
# rdm-idle-inhibit — Prevent screen timeout while audio/video is playing.
# Part of the RDM Desktop Environment.
#
# Uses sway-audio-idle-inhibit when available — it creates a proper Wayland
# zwp_idle_inhibit_manager_v1 surface that labwc and swayidle both respect
# natively.  The old SWAYSOCK check was wrong: labwc supports the idle
# inhibit protocol and swayidle honours it on any compositor.
#
# Falls back to pactl polling + wlrctl/ydotool only if
# sway-audio-idle-inhibit is not installed.

set -euo pipefail

POLL_INTERVAL=30  # seconds between audio checks in fallback mode

log() {
    logger -t rdm-idle-inhibit "$*"
}

# ── Method 1: sway-audio-idle-inhibit (preferred, works on labwc) ─────
if command -v sway-audio-idle-inhibit &>/dev/null; then
    log "Using sway-audio-idle-inhibit (zwp_idle_inhibit_manager_v1)"
    exec sway-audio-idle-inhibit
fi

# ── Fallback: poll pactl + reset idle timer manually ──────────────────
if ! command -v pactl &>/dev/null; then
    log "Neither sway-audio-idle-inhibit nor pactl found — cannot inhibit idle."
    log "Install sway-audio-idle-inhibit (AUR: sway-audio-idle-inhibit-git) or pipewire-pulse."
    exit 1
fi

reset_idle=""
if command -v wlrctl &>/dev/null; then
    reset_idle="wlrctl pointer move 1 0 && wlrctl pointer move -1 0"
elif command -v ydotool &>/dev/null; then
    reset_idle="ydotool mousemove -x 1 -y 0 && ydotool mousemove -x -1 -y 0"
fi

if [ -z "$reset_idle" ]; then
    log "sway-audio-idle-inhibit not found and no fallback tool available."
    log "Install sway-audio-idle-inhibit (recommended) or wlrctl."
    exit 1
fi

log "Fallback mode: polling pactl every ${POLL_INTERVAL}s, nudging pointer via: $reset_idle"

is_audio_playing() {
    pactl list sink-inputs 2>/dev/null | grep -qi "state:.*running"
}

inhibited=false
while true; do
    if is_audio_playing; then
        if [ "$inhibited" = false ]; then
            log "Audio playing — inhibiting idle"
            inhibited=true
        fi
        eval "$reset_idle" 2>/dev/null || true
    else
        if [ "$inhibited" = true ]; then
            log "Audio stopped — allowing idle"
            inhibited=false
        fi
    fi
    sleep "$POLL_INTERVAL"
done
