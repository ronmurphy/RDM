#!/bin/sh
# rdm-autostart — RDM session autostart
# Called from ~/.config/labwc/autostart after rdm-session starts.
#
# The MANAGED section is maintained by RDM and install.sh — do not edit it.
# Add your own startup commands in the USER AUTOSTART section below,
# or use RDM Settings > Autostart to manage them from the UI.

# ── MANAGED BY RDM — do not edit ──────────────────────────────────────

# Single-instance guard — prevent duplicate autostart processes
LOCK_FILE="${XDG_RUNTIME_DIR:-/tmp}/rdm-autostart.lock"
exec 9>"$LOCK_FILE"
if ! flock -n 9; then
    echo "rdm-autostart: already running, skipping" >&2
    exit 0
fi
# Inhibit screen blanking while audio is playing
if command -v rdm-idle-inhibit >/dev/null 2>&1; then
    rdm-idle-inhibit &
fi

# Rebuild KDE service cache so Dolphin/KDE apps have working "Open With" menus
if command -v kbuildsycoca6 >/dev/null 2>&1; then
    kbuildsycoca6 &
fi

# Tiling daemon (enabled via command center toggle or rdm.toml)
if command -v rdm-snap >/dev/null 2>&1; then
    rdm-snap keybinds-status 2>/dev/null | grep -q enabled && rdm-snap daemon &
fi

# ── USER AUTOSTART — add your entries below ────────────────────────────
